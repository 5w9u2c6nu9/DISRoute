<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <LangVersion>latest</LangVersion>
    <Version>1.0.0-rc.1</Version>
    <VersionPrefix>1.0.0</VersionPrefix>
    <VersionSuffix>rc.1</VersionSuffix>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <FileVersion>1.0.0.0</FileVersion>
    <InformationalVersion>1.0.0-rc.1</InformationalVersion>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <NuGetLockFilePath Condition="'$(DISROUTE_RID_RESTORE_DIR)' != ''">$(DISROUTE_RID_RESTORE_DIR)/$(MSBuildProjectName).lock.json</NuGetLockFilePath>
    <NuGetAudit Condition="'$(DISROUTE_ENABLE_NUGET_AUDIT)' == 'true'">true</NuGetAudit>
    <NuGetAuditMode Condition="'$(DISROUTE_ENABLE_NUGET_AUDIT)' == 'true'">all</NuGetAuditMode>
    <NuGetAuditLevel Condition="'$(DISROUTE_ENABLE_NUGET_AUDIT)' == 'true'">low</NuGetAuditLevel>
    <WarningsAsErrors Condition="'$(DISROUTE_ENABLE_NUGET_AUDIT)' == 'true'">$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
  </PropertyGroup>
</Project>
