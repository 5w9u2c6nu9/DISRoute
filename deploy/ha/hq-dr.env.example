ASPNETCORE_ENVIRONMENT=Production
Persistence__Provider=PostgreSQL
ConnectionStrings__DISRoute=Host=postgres-hq;Port=5432;Database=disroute;Username=disroute;Password=REPLACE_WITH_SECRET
HighAvailability__Enabled=true
HighAvailability__NodeId=hq-dr
HighAvailability__Site=HQ
HighAvailability__ConfiguredRole=GeographicDR
HighAvailability__AdvertisedAddress=https://hq-dr.example.invalid
HighAvailability__HeartbeatSeconds=2
HighAvailability__StaleNodeSeconds=10
HighAvailability__DatabaseTopology=SharedPrimary
HighAvailability__DatabaseFencingMode=None
# Geographic application promotion stays disabled until the HQ PostgreSQL replica has been promoted
# by the database HA layer. Automatic application promotion additionally requires an independent
# witness PostgreSQL connection reachable from both Dispatch and HQ.
HighAvailability__AllowAutomaticGeographicPromotion=false
HighAvailability__WitnessConnectionString=
Security__RequireAuthentication=true
Security__RequireHttps=true
Security__RequireMfa=true
