{
  "urls": "https://0.0.0.0:5443;http://127.0.0.1:5099",
  "Security": {
    "RequireAuthentication": true,
    "RequireHttps": true,
    "MaxRequestBodyBytes": 10485760,
    "GroupRoleMap": {
      "DISRoute-Dispatchers": "Dispatcher",
      "DISRoute-Supervisors": "Supervisor",
      "DISRoute-Administrators": "Administrator",
      "DISRoute-Fire": "Fire",
      "DISRoute-EMS": "EMS",
      "DISRoute-Police": "Police"
    },
    "RequireMfa": true,
    "MfaSessionMinutes": 30,
    "Ldap": {
      "Enabled": false,
      "Required": false,
      "Host": "",
      "Port": 636,
      "Mode": "Ldaps",
      "BaseDn": "",
      "BindDn": "",
      "BindPasswordFile": "",
      "UserFilter": "",
      "TimeoutSeconds": 5,
      "CacheMinutes": 5
    },
    "AllowInsecureProviderHttp": false,
    "Secrets": {
      "Directory": ""
    },
    "RateLimit": {
      "PermitLimitPerMinute": 600,
      "QueueLimit": 0
    },
    "ReverseProxy": {
      "Enabled": false,
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "Tls": {
      "Port": 5443,
      "CertificatePath": "",
      "CertificatePassword": "",
      "MinimumRemainingDays": 14
    }
  },
  "Persistence": {
    "Provider": "PostgreSQL",
    "ConnectionStringName": "DISRoute",
    "CheckpointPath": "data/disroute-state.json",
    "CheckpointSeconds": 2,
    "CommitTimeoutSeconds": 5,
    "BackupDirectory": "data/backups",
    "BackupRetentionCount": 30
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "JsonConsole": false
  },
  "HighAvailability": {
    "Enabled": false,
    "NodeId": "",
    "AdvertisedAddress": "",
    "Site": "Dispatch",
    "ConfiguredRole": "LocalStandby",
    "HeartbeatSeconds": 2,
    "StaleNodeSeconds": 10,
    "MaxPromotionLagSeconds": 10,
    "MaxPromotionLagBytes": 16777216,
    "DatabaseTopology": "SharedPrimary",
    "DatabaseFencingMode": "None",
    "AllowAutomaticGeographicPromotion": false,
    "WitnessConnectionString": ""
  },
  "Integrations": {
    "StationAlert": {
      "Endpoint": "",
      "BearerToken": ""
    },
    "FireReporting": {
      "Endpoint": "",
      "BearerToken": ""
    },
    "Printing": {
      "SpoolDirectory": ""
    }
  },
  "Alerting": {
    "UnacknowledgedAdvisorySeconds": 60,
    "UnacknowledgedWarningSeconds": 180
  },
  "Operations": {
    "MinimumFreeDiskBytes": 1073741824,
    "BackupWarningHours": 24
  }
}
