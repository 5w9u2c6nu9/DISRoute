<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:DISRoute.CAD"
        x:Class="DISRoute.CAD.ReplayWindow" Title="DISRoute Incident Replay" Width="1180" Height="820"
        MinWidth="900" MinHeight="620" Background="#101317">
  <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="10" RowSpacing="8">
    <Border Background="#1B2027" BorderBrush="#39414B" BorderThickness="1" Padding="10">
      <Grid ColumnDefinitions="*,Auto,280,Auto" ColumnSpacing="8">
        <StackPanel>
          <TextBlock Text="INCIDENT REPLAY" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="IncidentIdentityText" Foreground="#AAB4C0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Replay at UTC" VerticalAlignment="Center"/>
        <TextBox Grid.Column="2" x:Name="ReplayAtBox" PlaceholderText="2026-08-20T18:30:00Z"/>
        <Button Grid.Column="3" Content="LOAD SNAPSHOT" FontWeight="Bold" Click="LoadClicked"/>
      </Grid>
    </Border>

    <Border Grid.Row="1" Background="#151A20" BorderBrush="#39414B" BorderThickness="1" Padding="10">
      <Grid ColumnDefinitions="2*,1.1*,1.1*,1.1*" ColumnSpacing="12">
        <StackPanel><TextBlock Text="KNOWN INCIDENT STATE" FontWeight="Bold"/><TextBlock x:Name="IncidentStateText" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="1"><TextBlock Text="ASSIGNED UNITS" FontWeight="Bold"/><TextBlock x:Name="UnitSummaryText" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="2"><TextBlock Text="DISPATCH" FontWeight="Bold"/><TextBlock x:Name="DispatchSummaryText" TextWrapping="Wrap"/></StackPanel>
        <StackPanel Grid.Column="3"><TextBlock Text="OBSERVATIONS" FontWeight="Bold"/><TextBlock x:Name="ObservationSummaryText" TextWrapping="Wrap"/></StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="2*,1*" ColumnSpacing="8">
      <Border Background="#151A20" BorderBrush="#39414B" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,*">
          <TextBlock Text="WHAT DISROUTE KNEW / OBSERVED" FontWeight="Bold" FontSize="15"/>
          <ListBox Grid.Row="1" x:Name="TimelineList" Margin="0,8,0,0">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="local:ReplayTimelineRow">
                <Grid ColumnDefinitions="95,125,120,*" Margin="0,3" ColumnSpacing="8">
                  <TextBlock Text="{Binding Time}" Foreground="#8FA1B5"/>
                  <TextBlock Grid.Column="1" Text="{Binding Classification}" FontWeight="Bold"/>
                  <TextBlock Grid.Column="2" Text="{Binding Stream}"/>
                  <TextBlock Grid.Column="3" Text="{Binding Summary}" TextWrapping="Wrap"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>

      <Border Grid.Column="1" Background="#151A20" BorderBrush="#39414B" BorderThickness="1" Padding="8">
        <Grid RowDefinitions="Auto,*,Auto,*">
          <TextBlock Text="CORRECTED LATER" FontWeight="Bold" FontSize="15"/>
          <ListBox Grid.Row="1" x:Name="CorrectionsList" Margin="0,8,0,8">
            <ListBox.ItemTemplate><DataTemplate x:DataType="local:ReplayCorrectionRow"><StackPanel Margin="0,3"><TextBlock Text="{Binding Field}" FontWeight="Bold"/><TextBlock Text="{Binding Change}" TextWrapping="Wrap"/><TextBlock Text="{Binding Time}" Foreground="#8FA1B5"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Grid.Row="2" Text="REPLAY LIMITATIONS" FontWeight="Bold" FontSize="15"/>
          <ListBox Grid.Row="3" x:Name="LimitationsList" Margin="0,8,0,0"/>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="*,Auto">
      <TextBlock x:Name="StatusText" Text="Ready." Foreground="#AAB4C0"/>
      <Button Grid.Column="1" Content="Close" Click="CloseClicked"/>
    </Grid>
  </Grid>
</Window>
