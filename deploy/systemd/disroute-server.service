[Unit]
Description=DISRoute Server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=notify
WorkingDirectory=/opt/disroute/server
ExecStart=/opt/disroute/server/DISRoute.Server
Restart=always
RestartSec=3
User=disroute
Group=disroute
Environment=ASPNETCORE_ENVIRONMENT=Production
Environment=ASPNETCORE_URLS=http://127.0.0.1:5099
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/disroute/server/data

[Install]
WantedBy=multi-user.target
