{
  "urls": "https://0.0.0.0:5443",
  "ConnectionStrings": {
    "DISRoute": "secret://file/postgresql-connection.txt"
  },
  "Security": {
    "RequireAuthentication": true,
    "RequireHttps": true,
    "RequireMfa": true,
    "MaxRequestBodyBytes": 10485760,
    "AllowInsecureProviderHttp": false,
    "Secrets": {
      "Directory": "/etc/disroute/secrets"
    },
    "RateLimit": {
      "PermitLimitPerMinute": 600,
      "QueueLimit": 0
    },
    "ReverseProxy": {
      "Enabled": false,
      "ForwardLimit": 1,
      "KnownProxies": [],
      "KnownNetworks": []
    },
    "MfaKeyPath": "/etc/disroute/secrets/mfa.key",
    "OfflineLeaseKeyPath": "/etc/disroute/secrets/offline-lease.key",
    "MfaSessionKeyPath": "/etc/disroute/secrets/mfa-session.key",
    "Tls": {
      "Port": 5443,
      "CertificatePath": "/etc/disroute/secrets/server.pfx",
      "CertificatePassword": "secret://file/server-pfx-password.txt",
      "MinimumRemainingDays": 14
    }
  },
  "Persistence": {
    "Provider": "PostgreSQL",
    "CheckpointSeconds": 2,
    "CommitTimeoutSeconds": 5,
    "BackupDirectory": "/var/lib/disroute/backups",
    "BackupRetentionCount": 30
  },
  "HighAvailability": {
    "Enabled": false,
    "Site": "Dispatch",
    "ConfiguredRole": "LocalStandby",
    "DatabaseTopology": "SharedPrimary",
    "DatabaseFencingMode": "None",
    "WitnessConnectionString": ""
  },
  "Operations": {
    "MinimumFreeDiskBytes": 1073741824,
    "BackupWarningHours": 24
  },
  "Logging": {
    "JsonConsole": true,
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
